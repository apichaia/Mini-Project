tab1, tab2, tab3, tab4 = st.tabs([
    "📈 ยอดขาย & แนวโน้มการเติบโต", "🛍️ พฤติกรรมลูกค้า & ซื้อซ้ำ", "📦 สินค้า & หมวดหมู่", "🤝 ซัพพลายเออร์ & โปรโมชัน"
])

with tab1:
    c1, c2 = st.columns(2)
    with c1:
        rev_trend = df.groupby(['Month', 'region'])['revenue'].sum().reset_index()
        fig_trend = px.area(rev_trend, x='Month', y='revenue', color='region', title="<b>Monthly Revenue Trend by Region</b>")
        fig_trend.update_layout(margin=dict(l=20, r=20, t=50, b=20), hovermode="x unified")
        st.plotly_chart(fig_trend, use_container_width=True)
    with c2:
        rev_quarter = df.groupby(['Year_Q', 'region'])['revenue'].sum().reset_index()
        fig_q = px.bar(rev_quarter, x='Year_Q', y='revenue', color='region', barmode='group', title="<b>Quarterly Revenue Breakdown</b>")
        fig_q.update_layout(margin=dict(l=20, r=20, t=50, b=20))
        st.plotly_chart(fig_q, use_container_width=True)

with tab2:
    c3, c4 = st.columns(2)
    with c3:
        city_rev = df.groupby('customer_city')['revenue'].sum().reset_index().sort_values('revenue').tail(10)
        fig_city = px.bar(city_rev, x='revenue', y='customer_city', orientation='h', title="<b>Top 10 High-Value Customer Cities</b>", color='revenue', color_continuous_scale='Indigo')
        fig_city.update_layout(margin=dict(l=20, r=20, t=50, b=20), coloraxis_showscale=False)
        st.plotly_chart(fig_city, use_container_width=True)
    with c4:
        aov_city = (df.groupby('customer_city')['revenue'].sum() / df.groupby('customer_city')['order_id'].nunique()).reset_index(name='AOV').sort_values('AOV').tail(10)
        fig_aov = px.bar(aov_city, x='AOV', y='customer_city', orientation='h', title="<b>Highest AOV by City</b>", color='AOV', color_continuous_scale='Teal')
        fig_aov.update_layout(margin=dict(l=20, r=20, t=50, b=20), coloraxis_showscale=False)
        st.plotly_chart(fig_aov, use_container_width=True)
    
    cust_trend = df.groupby(['Month', 'region'])['customer_id'].nunique().reset_index(name='active_customers')
    fig_cust = px.line(cust_trend, x='Month', y='active_customers', color='region', markers=True, title="<b>Monthly Active Purchasers</b>")
    fig_cust.update_layout(margin=dict(l=20, r=20, t=50, b=20))
    st.plotly_chart(fig_cust, use_container_width=True)

with tab3:
    c5, c6 = st.columns(2)
    with c5:
        cat_perf = df.groupby('category')[['revenue', 'units_sold']].sum().reset_index()
        fig_cat = px.scatter(cat_perf, x='units_sold', y='revenue', size='revenue', color='category', hover_name='category', title="<b>Category Matrix</b>")
        fig_cat.update_layout(margin=dict(l=20, r=20, t=50, b=20))
        st.plotly_chart(fig_cat, use_container_width=True)
    with c6:
        cat_reg = df.groupby(['category', 'region'])['revenue'].sum().reset_index()
        fig_cat_reg = px.bar(cat_reg, x='category', y='revenue', color='region', title="<b>Category Mix by Region</b>")
        fig_cat_reg.update_layout(margin=dict(l=20, r=20, t=50, b=20))
        st.plotly_chart(fig_cat_reg, use_container_width=True)

with tab4:
    c7, c8 = st.columns(2)
    with c7:
        sup_rev = df.groupby(['supplier_country', 'category'])['revenue'].sum().reset_index()
        sup_rev = sup_rev[sup_rev['revenue'] > 0]
        fig_sup = px.sunburst(sup_rev, path=['supplier_country', 'category'], values='revenue', title="<b>Global Supplier vs. Category</b>")
        fig_sup.update_layout(margin=dict(l=20, r=20, t=50, b=20))
        st.plotly_chart(fig_sup, use_container_width=True)
    with c8:
        promo_rev = df.groupby(['promotion_name', 'region'])['revenue'].sum().reset_index()
        fig_promo = px.bar(promo_rev, x='revenue', y='promotion_name', color='region', orientation='h', title="<b>Campaign Revenue Impact</b>")
        fig_promo.update_layout(margin=dict(l=20, r=20, t=50, b=20))
        st.plotly_chart(fig_promo, use_container_width=True)