""", unsafe_allow_html=True)

# Sidebar
st.sidebar.markdown("### 🎛️ ตัวกรองข้อมูล (Filters)")
st.sidebar.markdown("---")

min_date = df_raw['order_date'].min()
max_date = df_raw['order_date'].max()

date_range = st.sidebar.date_input(
    "ช่วงวันที่", value=(min_date, max_date), min_value=min_date, max_value=max_date
)

available_regions = sorted(df_raw['region'].dropna().unique())
selected_regions = st.sidebar.multiselect("ภูมิภาค (Region)", available_regions, default=available_regions)

available_categories = sorted(df_raw['category'].dropna().unique())
selected_categories = st.sidebar.multiselect("หมวดหมู่สินค้า", available_categories, default=available_categories)

if len(date_range) == 2:
    start_date, end_date = date_range
    mask = (
        (df_raw['order_date'] >= pd.to_datetime(start_date)) & 
        (df_raw['order_date'] <= pd.to_datetime(end_date)) &
        (df_raw['region'].isin(selected_regions)) &
        (df_raw['category'].isin(selected_categories))
    )
    df = df_raw[mask]
else:
    df = df_raw.copy()

if df.empty:
    st.warning("⚠️ ไม่พบข้อมูลตามเงื่อนไขที่กรอก")
    st.stop()

COLOR_PALETTE = ["#6366F1", "#0EA5E9", "#10B981", "#F59E0B", "#EC4899", "#8B5CF6"]
px.defaults.template = "plotly_white"
px.defaults.color_discrete_sequence = COLOR_PALETTE

# =========================================================
# 4. Executive KPI Metrics Cards
# =========================================================
tot_rev = df['revenue'].sum()
tot_ord = df['order_id'].nunique()
aov_val = tot_rev / tot_ord if tot_ord > 0 else 0
tot_items = df['units_sold'].sum()
tot_ref = df['refund_amount'].sum()

cust_order_counts = df.groupby('customer_id')['order_id'].nunique()
repeat_customers = (cust_order_counts > 1).sum()
repeat_rate = (repeat_customers / len(cust_order_counts) * 100) if len(cust_order_counts) > 0 else 0

def format_number(num):
    if num >= 1_000_000_000:
        return f"{num/1_000_000_000:.2f}B"
    elif num >= 1_000_000:
        return f"{num/1_000_000:.2f}M"
    elif num >= 1_000:
        return f"{num/1_000:.1f}k"
    return f"{num:,.0f}"

m1, m2, m3, m4, m5, m6 = st.columns(6)

m1.metric("ยอดขายรวม (Revenue)", f"${format_number(tot_rev)}")
m2.metric("จำนวนคำสั่งซื้อ", f"{tot_ord:,}")
m3.metric("ยอดขายเฉลี่ย/คำสั่งซื้อ (AOV)", f"${aov_val:,.2f}")
m4.metric("สินค้าที่ขายได้", f"{format_number(tot_items)}")
m5.metric("อัตราซื้อซ้ำ (Repeat Rate)", f"{repeat_rate:.1f}%")
m6.metric("ยอดคืนเงินรวม (Refunds)", f"${format_number(tot_ref)}")

